# 这是配置示例，不含真实账号、密码或密钥。
# 复制为 Hub-server/.env，并替换 CHANGE_ME、your-* 和 example.invalid 等占位值。
# 真实 .env 已被 Git 忽略，请勿提交。

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=managehub

# 登录与会话：JWT_SECRET_KEY 必须替换为至少 32 字节的随机密钥。
JWT_SECRET_KEY=CHANGE_ME
JWT_ISSUER=managehub
JWT_AUDIENCE=managehub-api
SESSION_TTL=604800
# 本机 HTTP 使用 false；通过 HTTPS 访问时使用 true。
COOKIE_SECURE=false

# Redis：聊天检查点需要 Redis JSON 和 Search 功能。
REDIS_URL=redis://127.0.0.1:6379/0
# 如有密码，改为 redis://:your_redis_password@127.0.0.1:6379/0；特殊字符需要 URL 编码。

# SMTP 邮箱：以下为 QQ 邮箱服务器示例，密码填邮箱的 SMTP 授权码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM=sender@example.com

# 阿里云 OSS：以下为北京地域示例，Bucket 名称与访问凭据需自行填写。
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=CHANGE_ME
OSS_ACCESS_KEY_SECRET=CHANGE_ME
# 没有自定义图片域名时留空；私有图片由后端生成临时签名地址。
OSS_PUBLIC_BASE_URL=
OSS_USE_CNAME=false

# 聊天模型：填写服务商提供的 OpenAI 兼容接口及模型名。
LLM_MODEL=your-chat-model
LLM_BASE_URL=https://api.example.invalid/v1
LLM_API_KEY=CHANGE_ME

# 向量模型：接口可与聊天模型不同，模型需支持 embeddings。
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_BASE_URL=https://api.example.invalid/v1
EMBEDDING_API_KEY=CHANGE_ME
