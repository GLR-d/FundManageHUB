{
  "name": "hub-vue",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint src vite.config.mts eslint.config.mts scripts tests",
    "test": "node --experimental-strip-types --test tests/*.test.cts",
    "measure-startup": "node --experimental-strip-types scripts/measure-startup.cts",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "2.0.1",
    "axios": "^1.14.0",
    "vue": "^3.5.30",
    "vue-router": "^4.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.4.0",
    "jiti": "^2.7.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
