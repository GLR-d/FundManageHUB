import type { TestDouble } from './helpers/testTypes.cts'
const test: typeof import('node:test') = require('node:test')
const { assert, plain } = require('./helpers/runtime.cts')
const { fundDays, pageOfFunds, fundFixture } = require('./helpers/fundFixtures.cts')

test('global bill selection selects all loaded days, fills a partial selection and can clear it again', () => {
  const f = fundFixture()
  assert.equal(f.fund.allLoadedSelected.value, false)
  assert.equal(f.fund.partiallyLoadedSelected.value, false)
  f.fund.toggleAllLoaded()
  assert.equal(f.fund.selection.value.length, 0)
  f.fund.fundData.value = fundDays(3)
  const newest = '2026-10-03'
  f.fund.fundData.value[newest].push({ ...f.fund.fundData.value[newest][0], id: 30 })
  f.fund.selectFunds()
  f.fund.toggleAllLoaded()
  assert.equal(f.fund.allLoadedSelected.value, true)
  assert.equal(f.fund.partiallyLoadedSelected.value, false)
  assert.equal(f.fund.selection.value.length, 4)
  assert.equal(f.fund.selectionMap.value.size, 3)
  assert.deepEqual(plain(f.fund.selection.value.map((row: TestDouble) => row.id).sort((a: number, b: number) => a - b)), [1, 2, 3, 30])
  f.fund.toggleRow(newest, f.fund.fundData.value[newest][0], false)
  assert.equal(f.fund.allLoadedSelected.value, false)
  assert.equal(f.fund.partiallyLoadedSelected.value, true)
  f.fund.toggleAllLoaded()
  assert.equal(f.fund.selection.value.length, 4)
  assert.equal(f.fund.allLoadedSelected.value, true)
  f.fund.toggleAllLoaded()
  assert.equal(f.fund.selection.value.length, 0)
  assert.equal(f.fund.selectionMap.value.size, 0)
  assert.equal(f.fund.allLoadedSelected.value, false)
  assert.equal(f.fund.partiallyLoadedSelected.value, false)
  f.fund.cancelSelection()
  assert.equal(f.fund.showSelection.value, false)
  f.unmount()
})

test('global bill selection applies only to loaded rows and newly appended batches stay unselected', async () => {
  const data = fundDays(7)
  const requests: TestDouble[] = []
  const f = fundFixture({ getFundapi: async (config: TestDouble) => {
    requests.push(plain(config.params))
    return { code: 1, data: pageOfFunds(data, config.params) }
  } })
  await f.fund.selectList()
  f.fund.selectFunds()
  f.fund.toggleAllLoaded()
  assert.equal(f.fund.selection.value.length, 5)
  assert.equal(f.fund.allLoadedSelected.value, true)
  const selected = plain(f.fund.selection.value.map((row: TestDouble) => row.id))
  await f.fund.loadMoreDays()
  assert.equal(Object.keys(f.fund.fundData.value).length, 7)
  assert.deepEqual(plain(f.fund.selection.value.map((row: TestDouble) => row.id)), selected)
  assert.equal(f.fund.allLoadedSelected.value, false)
  assert.equal(f.fund.partiallyLoadedSelected.value, true)
  assert.equal(f.fund.selectionMap.value.has('2026-10-02'), false)
  assert.equal(f.fund.selectionMap.value.has('2026-10-01'), false)
  f.fund.toggleAllLoaded()
  assert.equal(f.fund.selection.value.length, 7)
  assert.equal(new Set(f.fund.selection.value.map((row: TestDouble) => row.id)).size, 7)
  assert.equal(f.fund.allLoadedSelected.value, true)
  assert.equal(f.fund.partiallyLoadedSelected.value, false)
  assert.deepEqual(requests, [{ days: 5 }, { days: 5, before: '2026-10-03' }])
  f.unmount()
})

test('native bill checkboxes select across days, clear one row, and remain consistent after appending days', async () => {
  const f=fundFixture()
  f.fund.fundData.value={ '2026-10-12':[{id:1},{id:2}], '2026-10-11':[{id:3}] }
  const first=f.fund.fundData.value['2026-10-12'], second=f.fund.fundData.value['2026-10-11']
  f.fund.toggleRow('2026-10-12',first[0],true)
  f.fund.toggleRow('2026-10-12',first[1],true)
  f.fund.toggleRow('2026-10-11',second[0],true)
  assert.equal(f.fund.selection.value.length,3)
  assert.equal(f.fund.selectionMap.value.get('2026-10-12').length,2)
  f.fund.toggleRow('2026-10-12',first[0],false)
  assert.equal(f.fund.selectionMap.value.get('2026-10-12').length,1)
  f.fund.toggleRow('2026-10-11',second[0],true)
  assert.deepEqual(plain(f.fund.selection.value.map((row: TestDouble)=>row.id)),[2,3])
  f.fund.loadMoreDays()
  assert.equal(f.fund.selection.value.length,2)
})
