{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.node.tsbuildinfo",
    "erasableSyntaxOnly": true
  },
  "include": [
    "vite.config.mts",
    "eslint.config.mts",
    "scripts/**/*.cts"
  ]
}
